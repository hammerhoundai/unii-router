#!/usr/bin/env bash
# unii-router: run UniiChat with lifecycle management, provider routing, and
# local-side HTTP(S) network guarding.
#
# Server:  unii-router [PORT] [extra unii serve arguments]
#          starts the local rewrite proxy (127.0.0.1:8899) and `unii serve`
#          (127.0.0.1:8788 by default).
#
# Client:  urc [PORT]
#          leak-proof wrapper: can only ever talk to the local server.

set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
here=$(dirname "$self")
proxy="$here/router-proxy.py"
arg0=$(basename "${BASH_SOURCE[0]}")
proxy_port=${UNII_CHAT_ROUTER_PROXY_PORT:-8899}
unii_port=${UNII_PORT:-8788}

mode=serve
case "$arg0" in
  urc) mode=client ;;
esac

if [[ $mode == client ]]; then
  forward=()
  for arg in "$@"; do
    if [[ "$arg" =~ ^[0-9]+$ ]]; then
      unii_port="$arg"
      continue
    fi
    if [[ "$arg" =~ ^https?:// && "$arg" != http://127.0.0.1:* && "$arg" != http://localhost:* ]]; then
      echo "urc: refusing non-local URL: $arg" >&2
      echo "this client can only talk to the local unii-router server" >&2
      exit 2
    fi
    forward+=("$arg")
  done
  # Force local: even a hostile/inherited UNII_URL cannot send data to uniichat.com.
  export UNII_URL="http://127.0.0.1:$unii_port"
  # Keep Unii client traffic local, but route its own non-local HTTP(S) traffic
  # through the same proxy so no client-side network path bypasses the policy.
  unset ALL_PROXY all_proxy
  export NO_PROXY="localhost,127.0.0.1,::1"
  export no_proxy="$NO_PROXY"
  export HTTP_PROXY="http://127.0.0.1:$proxy_port"
  export HTTPS_PROXY="$HTTP_PROXY"
  export http_proxy="$HTTP_PROXY"
  export https_proxy="$HTTP_PROXY"
  cfg_path="${UNII_CHAT_ROUTER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/unii-chat-router/config.json}"
  if [[ -f "$cfg_path" ]] && python3 - "$cfg_path" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as f:
    exit(0 if json.load(f).get("unii_no_telemetry") is True else 1)
PY
  then
    export UNII_NO_TELEMETRY="${UNII_NO_TELEMETRY:-1}"
  fi
  command -v unii >/dev/null || {
    echo "urc: unii is not in PATH" >&2
    exit 2
  }
  [[ -f "$here/urc-supervisor.py" ]] || {
    echo "urc: supervisor not found: $here/urc-supervisor.py" >&2
    exit 2
  }
  state=${XDG_STATE_HOME:-$HOME/.local/state}/unii-chat-router
  export URC_STATE_DIR="$state"
  export URC_SERVER_LAUNCHER="$self"
  python3 "$here/urc-supervisor.py" "$unii_port" "${forward[@]}"
  exit $?
fi

# Server mode: `unii-router [port]`. `serve` as the first argument is
# accepted but not duplicated.
forward=()
for arg in "$@"; do
  if [[ ${#forward[@]} -eq 0 && "$arg" == "serve" ]]; then
    continue
  fi
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    unii_port="$arg"
  fi
  forward+=("$arg")
done

port_is_free() {
  python3 - "$1" "$2" <<'PY'
import socket, sys

host, port = sys.argv[1], int(sys.argv[2])
with socket.socket() as sock:
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        sock.bind((host, port))
    except OSError:
        raise SystemExit(1)
PY
}

if ! port_is_free 127.0.0.1 "$proxy_port"; then
  echo "unii-router: proxy port 127.0.0.1:$proxy_port is already in use" >&2
  echo "  if unii-router is already running, use urc to connect to it" >&2
  exit 2
fi
if ! port_is_free 127.0.0.1 "$unii_port"; then
  echo "unii-router: server port 127.0.0.1:$unii_port is already in use" >&2
  echo "  if its server is already running, use urc to connect to it, or choose another port" >&2
  exit 2
fi

command -v unii >/dev/null || {
  echo "unii-router: unii is not in PATH" >&2
  exit 2
}
[[ -f "$proxy" ]] || {
  echo "unii-router: proxy not found: $proxy" >&2
  exit 2
}

state=${XDG_STATE_HOME:-$HOME/.local/state}/unii-chat-router
mkdir -p "$state/pki"
chmod 700 "$state" "$state/pki"

export CA_KEY="$state/pki/ca.key"
export CA_CERT="$state/pki/ca.pem"
export LEAF_CERT="$state/pki/api.anthropic.com.pem"
export LEAF_KEY="$state/pki/api.anthropic.com.key"
export LAST_REQUEST="$state/last-request.json"
cfg_path="${UNII_CHAT_ROUTER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/unii-chat-router/config.json}"
# Resolve provider, API key, and telemetry opt-out exactly as the proxy will
# (single source of truth).
resolved=$(UNII_CHAT_ROUTER_CONFIG="$cfg_path" python3 "$proxy" --resolve-key)
rprovider=$(sed -n 1p <<<"$resolved")
rkey=$(sed -n 2p <<<"$resolved")
no_telemetry=$(sed -n 3p <<<"$resolved")
if [[ -z "$rkey" ]]; then
  echo "unii-router: no API key resolved for provider '${rprovider:-deepseek}'" >&2
  echo "  set the key env var for that preset (e.g. DEEPSEEK_API_KEY / KIMI_API_KEY / ZAI_API_KEY)," >&2
  echo "  or set api_key / env_key for it in $cfg_path" >&2
  exit 2
fi
export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-$rkey}"
if [[ "$no_telemetry" == 1 ]]; then
  export UNII_NO_TELEMETRY="${UNII_NO_TELEMETRY:-1}"
fi
export HTTPS_PROXY="http://127.0.0.1:$proxy_port"
export HTTP_PROXY="$HTTPS_PROXY"
export NO_PROXY="localhost,127.0.0.1,::1"
export NODE_EXTRA_CA_CERTS="$CA_CERT"
export OPT_SITE="${OPT_SITE:-http://127.0.0.1:$unii_port}"

cleanup() {
  trap - EXIT INT TERM
  if [[ -n "${autostop_pid:-}" ]] && kill -0 "$autostop_pid" 2>/dev/null; then
    kill "$autostop_pid" 2>/dev/null || true
  fi
  if [[ -n "${unii_pid:-}" ]] && kill -0 "$unii_pid" 2>/dev/null; then
    kill "$unii_pid" 2>/dev/null || true
  fi
  if [[ -n "${proxy_pid:-}" ]] && kill -0 "$proxy_pid" 2>/dev/null; then
    kill "$proxy_pid" 2>/dev/null || true
    wait "$proxy_pid" 2>/dev/null || true
  fi
  if [[ -n "${unii_pid:-}" ]]; then
    wait "$unii_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

PROXY_PORT="$proxy_port" python3 "$proxy" &
proxy_pid=$!

sleep 0.25
if ! kill -0 "$proxy_pid" 2>/dev/null; then
  echo "unii-router: proxy exited before Unii started" >&2
  exit 1
fi

unii serve "${forward[@]}" &
unii_pid=$!
autostop_pid=
if [[ -n "${URC_AUTO_STOP_LOCK:-}" ]]; then
  python3 "$here/urc-autostop.py" "$URC_AUTO_STOP_LOCK" "$$" &
  autostop_pid=$!
fi
set +e
wait "$unii_pid"
status=$?
set -e
exit "$status"

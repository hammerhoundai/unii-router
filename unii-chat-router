#!/usr/bin/env bash
# unii-chat-router: run UniiChat with its model traffic routed to DeepSeek.
#
# Server:  unii-chat-router [PORT] [extra unii serve arguments]
#          starts the local rewrite proxy (127.0.0.1:8899) and `unii serve`
#          (127.0.0.1:8788 by default).
#
# Client:  unii-chat-router-client [PORT]
#          (or: unii-chat-router client [PORT])
#          leak-proof wrapper: can only ever talk to the local server.

set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
here=$(dirname "$self")
proxy="$here/deepseek-proxy.py"
arg0=$(basename "${BASH_SOURCE[0]}")
proxy_port=${UNII_CHAT_ROUTER_PROXY_PORT:-${UNII_DEEPSEEK_PROXY_PORT:-8899}}
unii_port=${UNII_PORT:-8788}

mode=serve
case "$arg0" in
  unii-chat-router-client|unii-deepseek-client) mode=client ;;
esac
if [[ $mode == serve && ${1:-} == client ]]; then
  shift
  mode=client
fi

if [[ $mode == client ]]; then
  forward=()
  for arg in "$@"; do
    if [[ "$arg" =~ ^[0-9]+$ ]]; then
      unii_port="$arg"
      continue
    fi
    if [[ "$arg" =~ ^https?:// && "$arg" != http://127.0.0.1:* && "$arg" != http://localhost:* ]]; then
      echo "unii-chat-router client: refusing non-local URL: $arg" >&2
      echo "this client can only talk to the local unii-chat-router server" >&2
      exit 2
    fi
    forward+=("$arg")
  done
  # Force local: even a hostile/inherited UNII_URL cannot send data to uniichat.com.
  export UNII_URL="http://127.0.0.1:$unii_port"
  unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy
  command -v unii >/dev/null || {
    echo "unii-chat-router client: unii is not in PATH" >&2
    exit 2
  }
  exec unii "${forward[@]}"
fi

# Server mode: `unii-chat-router [port]`. `serve` as the first argument is
# accepted but not duplicated.
forward=()
for arg in "$@"; do
  if [[ ${#forward[@]} -eq 0 && "$arg" == "serve" ]]; then
    continue
  fi
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    unii_port="$arg"
  fi
  forward+=("$arg")
done

if [[ -z "${DEEPSEEK_API_KEY:-}" ]]; then
  echo "unii-chat-router: DEEPSEEK_API_KEY is not set" >&2
  exit 2
fi
command -v unii >/dev/null || {
  echo "unii-chat-router: unii is not in PATH" >&2
  exit 2
}
[[ -f "$proxy" ]] || {
  echo "unii-chat-router: proxy not found: $proxy" >&2
  exit 2
}

state=${XDG_STATE_HOME:-$HOME/.local/state}/unii-chat-router
mkdir -p "$state/pki"
chmod 700 "$state" "$state/pki"

export CA_KEY="$state/pki/ca.key"
export CA_CERT="$state/pki/ca.pem"
export LEAF_CERT="$state/pki/api.anthropic.com.pem"
export LEAF_KEY="$state/pki/api.anthropic.com.key"
export LAST_REQUEST="$state/last-request.json"
export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-$DEEPSEEK_API_KEY}"
export HTTPS_PROXY="http://127.0.0.1:$proxy_port"
export HTTP_PROXY="$HTTPS_PROXY"
export NO_PROXY="localhost,127.0.0.1,::1"
export NODE_EXTRA_CA_CERTS="$CA_CERT"
export OPT_SITE="${OPT_SITE:-http://127.0.0.1:$unii_port}"
export UNII_NO_TELEMETRY="${UNII_NO_TELEMETRY:-1}"

cleanup() {
  trap - EXIT INT TERM
  if [[ -n "${proxy_pid:-}" ]] && kill -0 "$proxy_pid" 2>/dev/null; then
    kill "$proxy_pid" 2>/dev/null || true
    wait "$proxy_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

DEEPSEEK_API_KEY="$DEEPSEEK_API_KEY" PROXY_PORT="$proxy_port" \
  python3 "$proxy" &
proxy_pid=$!

sleep 0.25
if ! kill -0 "$proxy_pid" 2>/dev/null; then
  echo "unii-chat-router: proxy exited before Unii started" >&2
  exit 1
fi

unii serve "${forward[@]}" &
unii_pid=$!
set +e
wait "$unii_pid"
status=$?
set -e
exit "$status"
